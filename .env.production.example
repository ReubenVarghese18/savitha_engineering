# Copy to .env.production and fill in. NEVER commit .env.production.
DOMAIN=example.com

# Strong random values. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Quote alert emails (leave SMTP_HOST empty to switch alerts off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
QUOTE_ALERT_TO=

# Days of daily database backups to keep in ./backups (copy them off the server too)
BACKUP_KEEP_DAYS=14

# Optional error tracking
SENTRY_DSN=
