# Database Configuration
DATABASE_URL=sqlite:///./catalog.db
# For PostgreSQL production: DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security - JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
ALGORITHM=HS256

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Public site URL used in sitemap.xml (no trailing slash)
SITE_URL=https://savithaengineering.com

# Email alerts for new quote requests (any SMTP provider; leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
QUOTE_ALERT_TO=sales@example.com,owner@example.com

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Environment
ENVIRONMENT=development
# Set to 'production' when deployed
